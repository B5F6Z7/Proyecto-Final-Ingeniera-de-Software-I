<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- CU3 · Editar evento. App asigna PantallaEventoController con setController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla" spacing="20">

    <VBox spacing="4">
        <Label text="CU3 · ORGANIZADOR" styleClass="antetitulo"/>
        <Label text="Editar evento" styleClass="titulo"/>
        <Label text="Cargue el evento, cambie sus datos y guarde. El aforo no puede quedar por debajo de los cupos ocupados y bloqueados."
               styleClass="subtitulo" wrapText="true"/>
    </VBox>

    <VBox styleClass="tarjeta" spacing="8">
        <Label text="Identificador del evento" styleClass="etiqueta-campo"/>
        <HBox spacing="10">
            <TextField fx:id="campoEventoId" promptText="Por ejemplo: ev-1" onAction="#alCargar"
                       HBox.hgrow="ALWAYS"/>
            <Button text="Cargar evento" styleClass="boton-secundario" onAction="#alCargar"/>
        </HBox>
    </VBox>

    <VBox styleClass="tarjeta" spacing="14">
        <Label text="Datos del evento" styleClass="tarjeta-titulo"/>
        <VBox spacing="6">
            <Label text="Nombre" styleClass="etiqueta-campo"/>
            <TextField fx:id="campoNombre"/>
        </VBox>
        <HBox spacing="14">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Fecha" styleClass="etiqueta-campo"/>
                <DatePicker fx:id="campoFecha" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Hora (HH:mm)" styleClass="etiqueta-campo"/>
                <TextField fx:id="campoHora" promptText="19:00" prefColumnCount="6"/>
            </VBox>
        </HBox>
        <HBox spacing="14">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Lugar" styleClass="etiqueta-campo"/>
                <TextField fx:id="campoLugar"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Aforo" styleClass="etiqueta-campo"/>
                <TextField fx:id="campoAforo" prefColumnCount="6"/>
            </VBox>
        </HBox>
        <HBox>
            <Button text="Guardar cambios" styleClass="boton-principal" onAction="#alGuardar"/>
        </HBox>
    </VBox>

    <Label fx:id="etiquetaMensaje" styleClass="mensaje" wrapText="true" maxWidth="Infinity"/>
</VBox>
