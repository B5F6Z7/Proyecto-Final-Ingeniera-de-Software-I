<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- CU2 · Reservar y confirmar una entrada. App asigna PantallaReservaController con setController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla" spacing="14">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Reservar una entrada" styleClass="titulo"/>
    <Label text="La reserva queda pendiente y se debe confirmar antes de 10 minutos."
           styleClass="subtitulo" wrapText="true"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Evento:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoEventoId" promptText="ev-1"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Estudiante:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoEstudianteId" promptText="Código del estudiante"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Código de la reserva:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="campoCodigo" promptText="Se llena al solicitar" prefColumnCount="28"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Solicitar reserva" styleClass="boton-principal" onAction="#alSolicitar"/>
        <Button text="Confirmar reserva" onAction="#alConfirmar"/>
    </HBox>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje" wrapText="true"/>
</VBox>
