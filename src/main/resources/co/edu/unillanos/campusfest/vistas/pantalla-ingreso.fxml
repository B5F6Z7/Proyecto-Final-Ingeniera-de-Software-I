<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- CU4 · Registrar el ingreso con QR. App asigna PantallaIngresoController con setController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla" spacing="20">

    <VBox spacing="4">
        <Label text="CU4 · ENCARGADO DE LA ENTRADA" styleClass="antetitulo"/>
        <Label text="Registrar ingreso" styleClass="titulo"/>
        <Label text="Escanee el código QR de la reserva (el lector lo escribe en el campo) o péguelo y presione Enter."
               styleClass="subtitulo" wrapText="true"/>
    </VBox>

    <VBox styleClass="tarjeta" spacing="14">
        <VBox spacing="6">
            <Label text="Evento" styleClass="etiqueta-campo"/>
            <TextField fx:id="campoEventoId" promptText="ev-1"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Código QR de la reserva" styleClass="etiqueta-campo"/>
            <TextField fx:id="campoCodigo" promptText="Escanee o pegue el código aquí"
                       styleClass="campo-codigo,campo-grande" onAction="#alRegistrar"/>
        </VBox>
        <HBox>
            <Button text="Registrar ingreso" styleClass="boton-principal,boton-grande"
                    onAction="#alRegistrar"/>
        </HBox>
        <Label text="El resultado o el motivo del rechazo aparece abajo."
               styleClass="ayuda" wrapText="true"/>
    </VBox>

    <Label fx:id="etiquetaMensaje" styleClass="mensaje,mensaje-grande" wrapText="true" maxWidth="Infinity"/>
</VBox>
