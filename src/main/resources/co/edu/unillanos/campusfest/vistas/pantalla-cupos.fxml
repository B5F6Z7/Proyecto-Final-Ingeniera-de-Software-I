<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<!-- CU1 · Consultar cupos. App asigna PantallaCuposController con setController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla" spacing="14">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Consultar cupos" styleClass="titulo"/>
    <Label text="Escriba el identificador del evento para ver cuántos cupos quedan libres."
           styleClass="subtitulo" wrapText="true"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Evento:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoEventoId" promptText="ev-1" onAction="#alConsultar"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    </GridPane>
    <Button text="Consultar" styleClass="boton-principal" onAction="#alConsultar"/>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje" wrapText="true"/>
</VBox>
