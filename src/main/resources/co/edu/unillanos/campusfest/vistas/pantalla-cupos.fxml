<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- CU1 · Consultar cupos. App asigna PantallaCuposController con setController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla" spacing="20">

    <VBox spacing="4">
        <Label text="CU1 · ESTUDIANTE" styleClass="antetitulo"/>
        <Label text="Consultar cupos" styleClass="titulo"/>
        <Label text="Revise cuántos cupos quedan libres en un evento antes de reservar."
               styleClass="subtitulo" wrapText="true"/>
    </VBox>

    <VBox styleClass="tarjeta" spacing="8">
        <Label text="Identificador del evento" styleClass="etiqueta-campo"/>
        <HBox spacing="10">
            <TextField fx:id="campoEventoId" promptText="Por ejemplo: ev-1" onAction="#alConsultar"
                       HBox.hgrow="ALWAYS"/>
            <Button text="Consultar" styleClass="boton-principal" onAction="#alConsultar"/>
        </HBox>
        <Label text="Eventos de ejemplo: ev-1 (Concierto de bienvenida) y ev-2 (Feria de emprendimiento)."
               styleClass="ayuda" wrapText="true"/>
    </VBox>

    <VBox styleClass="tarjeta,tarjeta-resultado" spacing="2">
        <Label text="CUPOS DISPONIBLES" styleClass="resultado-titulo"/>
        <Label fx:id="etiquetaCupos" text="—" styleClass="resultado-numero"/>
        <Label text="Aforo menos bloqueados, confirmadas y pendientes vigentes."
               styleClass="ayuda" wrapText="true"/>
    </VBox>

    <Label fx:id="etiquetaMensaje" styleClass="mensaje" wrapText="true" maxWidth="Infinity"/>
</VBox>
