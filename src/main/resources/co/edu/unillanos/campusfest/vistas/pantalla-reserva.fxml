<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- CU2 · Reservar y confirmar una entrada. App asigna PantallaReservaController con setController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla" spacing="20">

    <VBox spacing="4">
        <Label text="CU2 · ESTUDIANTE" styleClass="antetitulo"/>
        <Label text="Reservar una entrada" styleClass="titulo"/>
        <Label text="Solicite la reserva y confírmela antes de la hora límite que le muestra el sistema."
               styleClass="subtitulo" wrapText="true"/>
    </VBox>

    <VBox styleClass="tarjeta" spacing="12">
        <HBox spacing="10" styleClass="paso">
            <Label text="1" styleClass="paso-numero" minWidth="28" minHeight="28"/>
            <Label text="Solicitar la reserva" styleClass="tarjeta-titulo"/>
        </HBox>
        <HBox spacing="14">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Evento" styleClass="etiqueta-campo"/>
                <TextField fx:id="campoEventoId" promptText="ev-1"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Código del estudiante" styleClass="etiqueta-campo"/>
                <TextField fx:id="campoEstudianteId" promptText="Por ejemplo: 160004512"/>
            </VBox>
        </HBox>
        <HBox>
            <Button text="Solicitar reserva" styleClass="boton-principal" onAction="#alSolicitar"/>
        </HBox>
    </VBox>

    <VBox styleClass="tarjeta" spacing="12">
        <HBox spacing="10" styleClass="paso">
            <Label text="2" styleClass="paso-numero" minWidth="28" minHeight="28"/>
            <Label text="Confirmar la reserva" styleClass="tarjeta-titulo"/>
        </HBox>
        <VBox spacing="6">
            <Label text="Código de la reserva (es el contenido del QR)" styleClass="etiqueta-campo"/>
            <TextField fx:id="campoCodigo" promptText="Se llena solo al solicitar la reserva"
                       styleClass="campo-codigo"/>
        </VBox>
        <HBox>
            <Button text="Confirmar reserva" styleClass="boton-exito" onAction="#alConfirmar"/>
        </HBox>
    </VBox>

    <Label fx:id="etiquetaMensaje" styleClass="mensaje" wrapText="true" maxWidth="Infinity"/>
</VBox>
